<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvFilePicker" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:buttonStyle">@style/Widget.TvFilePicker.Button</item>
    </style>

    <style name="Widget.TvFilePicker.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_background</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">52dp</item>
    </style>
</resources>
